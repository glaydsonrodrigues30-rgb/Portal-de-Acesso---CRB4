rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny: All access blocked by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Identifies the initial root admin via verified auth email and active admin document
    function isGlaydsonAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'glaydson.rodrigues30@gmail.com' &&
        exists(/databases/$(database)/documents/users/admin_glaydson) &&
        get(/databases/$(database)/documents/users/admin_glaydson).data.status == 'ATIVO';
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Valid profile requires authentication, status == 'ATIVO', and recognized perfil
    function hasValidProfile() {
      return isSignedIn() && (
        (hasUserDoc() && getUserData().status == 'ATIVO' && getUserData().perfil in ['ADMIN', 'OPERACIONAL', 'VISUALIZADOR'])
        || isGlaydsonAdmin()
      );
    }

    function getUserRole() {
      return hasUserDoc()
        ? getUserData().perfil
        : (isGlaydsonAdmin() ? 'ADMIN' : 'NONE');
    }

    function isAdmin() {
      return hasValidProfile() && (getUserRole() == 'ADMIN' || isGlaydsonAdmin());
    }

    function isOperacional() {
      return hasValidProfile() && (getUserRole() == 'OPERACIONAL' || isAdmin());
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Authenticated users with valid profile can read user records
      allow read: if hasValidProfile();

      // Only an existing admin can create users.
      // Glaydson can also initialize his own UID record if it matches his email.
      // Self-promotion to admin by non-admins is strictly prevented.
      allow create: if (isAdmin() && request.resource.data.perfil in ['ADMIN', 'OPERACIONAL', 'VISUALIZADOR'])
                   || (isSignedIn() && request.auth.uid == userId && isGlaydsonAdmin() && request.resource.data.perfil == 'ADMIN');

      // Only an existing admin can update user documents
      allow update: if isAdmin()
                   && request.resource.data.perfil in ['ADMIN', 'OPERACIONAL', 'VISUALIZADOR'];

      // Only admin can delete users, and cannot delete themselves
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    // --- Operational Collections ---
    // Read allowed for any user with valid profile (including VISUALIZADOR).
    // Write (create, update, delete) allowed ONLY for OPERACIONAL and ADMIN.
    match /debits/{debitoId} {
      allow read: if hasValidProfile();
      allow create, update, delete: if isOperacional();
    }

    match /notifications/{notificacaoId} {
      allow read: if hasValidProfile();
      allow create, update, delete: if isOperacional();
    }

    match /negotiations/{negociacaoId} {
      allow read: if hasValidProfile();
      allow create, update, delete: if isOperacional();
    }

    match /oficios/{oficioId} {
      allow read: if hasValidProfile();
      allow create, update, delete: if isOperacional();
    }

    match /processos/{processoId} {
      allow read: if hasValidProfile();
      allow create, update, delete: if isOperacional();
    }

    // --- Audit Trail (auditoria) ---
    // Immutable audit logs: any authenticated user with valid profile can append, none can modify or delete
    match /auditoria/{logId} {
      allow read: if hasValidProfile();
      allow create: if hasValidProfile();
      allow update, delete: if false;
    }
  }
}
